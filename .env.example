# 복사해서 .env로 사용 (cp .env.example .env)

# --- WAF ---
# P0에서 다이제스트로 고정함. 기존 .env의 WAF_TAG(=nginx@sha256:...) 값을 유지할 것
WAF_TAG=nginx
WAF_HTTP_PORT=8080
# waf가 바라볼 백엔드 서비스명. 기본 app, P0 회귀 시 echo
WAF_BACKEND=app

# --- 앱/DB ---
POSTGRES_USER=panoptes
POSTGRES_PASSWORD=panoptes
POSTGRES_DB=panoptes
# openssl rand -hex 32 로 생성한 값으로 교체 권장
SESSION_SECRET=dev-only-change-me
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=10
APP_TAG=dev

# --- P0 회귀용 echo 백엔드 ---
ECHO_TAG=latest
